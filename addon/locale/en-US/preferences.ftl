pref-title = Annotation Crosshair
pref-enabled =
    .label = Show crosshair while the Select Area tool is active
pref-color-light = Line colour on light pages
pref-color-dark = Line colour on dark pages
pref-color-reset =
    .label = Reset
pref-help = With Select Area active, guide lines span the PDF page under the pointer so you can line up the selection with a figure's edges. The colour follows the page background, so a dark reader theme uses the dark-page colour.
